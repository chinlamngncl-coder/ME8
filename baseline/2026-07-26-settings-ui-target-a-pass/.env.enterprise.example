# Mobility Axiom PostgreSQL primary catalog + optional Valkey runtime cache.
# Copy lines into .env after: docker compose -f docker/docker-compose.enterprise.yml up -d
# See docs/ME8-ENV-ENTERPRISE.md

# --- Valkey runtime cache (GPS / online / SIP contact) — optional ---
# Unset = memory + JSON only (today's lab behaviour). Never blocks SOS/live/PTT.
FM_REDIS_URL=redis://127.0.0.1:6379
# FM_REDIS_CONNECT_TIMEOUT_MS=5000
# FM_REDIS_KEY_PREFIX=me8:

# --- PostgreSQL catalog — evidence metadata, BWC registry, audit ---
FM_CATALOG_DB_URL=postgresql://mobility:mobility_dev_change_me@127.0.0.1:5432/mobility

# Required: startup fails before listeners if PostgreSQL is unavailable.
FM_CATALOG_MODE=postgres_required
# Tactical floor-plan upload max MB (default 25, clamp 5..50; set 50 for enterprise)
# FM_TACTICAL_BP_MAX_MB=25
FM_CATALOG_CONNECT_TIMEOUT_MS=5000
FM_CATALOG_QUERY_TIMEOUT_MS=15000
FM_CATALOG_POOL_MAX=10

# --- SaaS dual mode (Step 2 DYNAMIC-FRONTEND-UI-V1) ---
# on_prem (default) = full Server/Network/SSL chrome
# cloud_leased = hide Server / Network / Inbound infra tabs for leased tenants
# FM_DEPLOYMENT_MODE=on_prem
# FM_ORG_ID=default
# FM_TENANT_LICENSE_ENFORCE=0
# FM_TENANT_SOCKET_ISOLATE=1
